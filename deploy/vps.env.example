GOLFPRO_BIND_IP=127.0.0.1
GOLFPRO_HOST_PORT=8087

# Required for login/registration. Vite embeds these at build time,
# so rebuild the container after changing them.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional aliases if you prefer Next.js-style naming:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
